# Copy to collector/.env (gitignored) on the Proxmox node that runs the collector.

# --- GitHub (read-only; used for velocity, changelog, roadmap) --------------------------------
# A fine-grained PAT covers ONE owner, so either use one classic PAT (scopes: repo, read:org)
# or set one fine-grained PAT per org with the override pattern below.
# Fine-grained permissions needed: Contents read, Metadata read, Pull requests read, Issues read.
GITHUB_TOKEN=
# Per-org overrides: GITHUB_TOKEN__<ORG uppercased, non-alphanumerics as _>
# GITHUB_TOKEN__FG_COLLECTSHOP=
# GITHUB_TOKEN__FG_CRYPTOLABS=
# GITHUB_TOKEN__FG_POLYLABS=
# GITHUB_TOKEN__FGL_SERVICES=
# GITHUB_TOKEN__FUTUREGADGETLABS_WATCHTOWER=
# GITHUB_API_URL=https://api.github.com

# --- Proxmox node stats ------------------------------------------------------------------------
# Leave blank to use `pvesh` directly (works when the collector runs as root on a PVE node).
# Otherwise create an API token with the PVEAuditor role: Datacenter > Permissions > API Tokens.
PVE_API_URL=https://127.0.0.1:8006/api2/json
PVE_TOKEN_ID=watchtower@pve!collector
PVE_TOKEN_SECRET=
PVE_VERIFY_TLS=false

# --- This run ----------------------------------------------------------------------------------
WATCHTOWER_NODE_NAME=pve-01
# Checkout of FutureGadgetLabs-Watchtower/futuregadgetlabs-watchtower.github.io that the collector commits into.
WATCHTOWER_REPO_DIR=/opt/fgl-watchtower
# Real targets live here (gitignored). Start from watchtower.config.example.json.
WATCHTOWER_CONFIG=/opt/fgl-watchtower/collector/watchtower.config.json
# Rolling health history (streaks, 30-day uptime). Kept off git.
WATCHTOWER_STATE_DIR=/var/lib/fgl-watchtower

# --- Health check tuning -----------------------------------------------------------------------
HEALTH_HTTP_TIMEOUT=8
HEALTH_DEGRADED_MS=800
HEALTH_HISTORY_LEN=48
VELOCITY_WEEKS=12

# --- Git publish -------------------------------------------------------------------------------
# Push with a deploy key that has write access to this one repo (Settings > Deploy keys).
# A push made with a deploy key triggers the Pages workflow; one made with GITHUB_TOKEN would not.
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_AUTHOR=Watchtower Collector <watchtower-collector@users.noreply.github.com>
# Commit at least this often even when nothing but timestamps changed, so the site's
# "Last sync" stays fresh. Status changes always commit immediately.
SYNC_HEARTBEAT_MINUTES=60
